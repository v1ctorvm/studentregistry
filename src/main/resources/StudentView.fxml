<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0">
         <top>
            <VBox prefHeight="87.0" prefWidth="600.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="31.0" prefWidth="600.0">
                     <children>
                        <Label text="Nome:" />
                        <TextField fx:id="txtName" />
                        <Label text="Email: ">
                           <HBox.margin>
                              <Insets left="5.0" />
                           </HBox.margin>
                        </Label>
                        <TextField fx:id="txtEmail" />
                        <Label text="Nota:">
                           <HBox.margin>
                              <Insets left="5.0" />
                           </HBox.margin>
                        </Label>
                        <Spinner fx:id="spnGrade" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="10.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Button fx:id="btnAdd" mnemonicParsing="false" text="Adicionar">
                           <HBox.margin>
                              <Insets right="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="btnToggle" mnemonicParsing="false" text="Alternar Ativo">
                           <HBox.margin>
                              <Insets right="5.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="btnUpdate" mnemonicParsing="false" text="Atualizar Nota" />
                     </children>
                     <VBox.margin>
                        <Insets left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </top>
         <center>
            <TableView fx:id="table" prefHeight="286.0" prefWidth="600.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="colName" prefWidth="175.0" style="-fx-alignment: CENTER;" text="Nome" />
                <TableColumn fx:id="colEmail" minWidth="2.0" prefWidth="260.0" text="Email" />
                  <TableColumn fx:id="colGrade" minWidth="0.0" prefWidth="74.0" text="Nota" />
                  <TableColumn fx:id="colActive" prefWidth="90.0" text="Ativo" />
              </columns>
            </TableView>
         </center>
         <bottom>
            <HBox prefHeight="25.0" prefWidth="600.0" spacing="8.0" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="lblError" prefHeight="17.0" prefWidth="81.0" textFill="RED" />
                  <ProgressIndicator fx:id="progress" prefHeight="17.0" prefWidth="90.0" progress="0.0" visible="false" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
